# Public site URL (used for SEO, sitemap, and social sharing)
NEXT_PUBLIC_SITE_URL=https://rin-nairith-services.vercel.app

# Contact form delivery
# ======================
# 1) Telegram notification:
#    Create a bot with @BotFather and get its token; get your chat id (e.g. via @userinfobot).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 2) Email delivery via Resend (https://resend.com):
#    Get an API key from Resend and verify your domain (or use onboarding@resend.dev for testing).
RESEND_API_KEY=
# Sender shown on the email (must be a verified address/domain in Resend).
# CONTACT_EMAIL_FROM=RIN NAIRITH <onboarding@resend.dev>
# Where the inquiry email lands (defaults to your inbox).
CONTACT_EMAIL_TO=nairithrin143@gmail.com